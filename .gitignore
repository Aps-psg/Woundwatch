# ─────────────────────────────────────────────────────────────────────────────
# WoundWatch — monorepo root .gitignore
# Covers both backend/ (Python/FastAPI) and frontend/ (Expo/React Native)
# ─────────────────────────────────────────────────────────────────────────────

# ── Python / Backend ──────────────────────────────────────────────────────────
venv/
.venv/
env/
ENV/
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/

# ML model binary weights (downloaded via HuggingFace at runtime)
*.dylib
*.so
*.bin
*.pt
*.pth
.cache/
huggingface/

# ── Node / Frontend ───────────────────────────────────────────────────────────
node_modules/
.expo/
.expo-shared/
web-build/
*.jsbundle

# ── Shared ────────────────────────────────────────────────────────────────────
data/
*.zip
.env
.env.*
*.log
logs/

# ── macOS ─────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── IDE ───────────────────────────────────────────────────────────────────────
.idea/
*.swp
*.swo

# ── web/ (Next.js Vercel wrapper) ─────────────────────────────────────────────
# public/ is populated at build time by `npx expo export` — never commit it
web/public/*
!web/public/README.md
web/node_modules/
web/.next/
web/.env.local
