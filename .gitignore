# ─────────────────────────────────────────────────────────────────────────────
# WoundWatch — monorepo root .gitignore
# Covers both backend/ (Python/FastAPI) and frontend/ (Expo/React Native)
# ─────────────────────────────────────────────────────────────────────────────

# ── Python / Backend ──────────────────────────────────────────────────────────
venv/
.venv/
env/
ENV/
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/

# ML model binary weights (downloaded via HuggingFace at runtime)
*.dylib
*.so
*.bin
*.pt
*.pth
.cache/
huggingface/

# ── Node / Frontend ───────────────────────────────────────────────────────────
node_modules/
.expo/
.expo-shared/
web-build/
*.jsbundle

# ── Shared ────────────────────────────────────────────────────────────────────
data/
*.zip
.env
.env.*
*.log
logs/

# ── macOS ─────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── IDE ───────────────────────────────────────────────────────────────────────
.idea/
*.swp
*.swo
